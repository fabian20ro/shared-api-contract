{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/fabian20ro/shared-api-contract/v2.0.0/schema/module.schema.json",
  "title": "Shared API module manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "contractVersion", "runtime", "build", "routes", "config", "contracts"],
  "properties": {
    "$schema": { "type": "string", "const": "https://raw.githubusercontent.com/fabian20ro/shared-api-contract/v2.0.0/schema/module.schema.json" },
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
    "contractVersion": { "const": 2 },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["abi", "profiles", "capabilities"],
      "properties": {
        "abi": { "const": "web-fetch-v1" },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["node-24", "web-worker"] }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["outbound-fetch", "abort-signal", "web-crypto", "binary-response"] }
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "export", "output"],
      "properties": {
        "entry": { "type": "string", "pattern": "^src/[A-Za-z0-9._/-]+\\.ts$" },
        "export": { "const": "createHandler" },
        "output": { "type": "string", "pattern": "^dist/[A-Za-z0-9._/-]+\\.js$" }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "methods", "response"],
        "properties": {
          "path": { "type": "string", "pattern": "^/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*$" },
          "methods": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "HEAD"] }
          },
          "response": { "enum": ["json", "binary", "text", "stream"] }
        }
      }
    },
    "config": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "required", "sensitive"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
          "type": { "enum": ["string", "string[]", "integer", "boolean"] },
          "required": { "type": "boolean" },
          "sensitive": { "type": "boolean" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
          "kind": { "enum": ["http-api", "database-api"] }
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtureDirectory"],
      "properties": {
        "fixtureDirectory": { "type": "string", "pattern": "^test/[A-Za-z0-9._/-]+$" }
      }
    }
  }
}
