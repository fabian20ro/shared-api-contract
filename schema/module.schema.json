{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/fabian20ro/shared-api-contract/v1.0.1/schema/module.schema.json",
  "title": "Shared API module manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "contractVersion",
    "runtime",
    "build",
    "routes",
    "config",
    "contracts"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$"
    },
    "contractVersion": {
      "type": "integer",
      "minimum": 1
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "major"
      ],
      "properties": {
        "family": {
          "const": "node"
        },
        "major": {
          "const": 24
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry",
        "export",
        "output"
      ],
      "properties": {
        "entry": {
          "type": "string",
          "pattern": "^src/[A-Za-z0-9._/-]+\\.ts$"
        },
        "export": {
          "const": "createHandler"
        },
        "output": {
          "type": "string",
          "pattern": "^dist/[A-Za-z0-9._/-]+\\.js$"
        }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "methods",
          "response"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*$"
          },
          "methods": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "GET",
                "POST",
                "PUT",
                "PATCH",
                "DELETE",
                "OPTIONS",
                "HEAD"
              ]
            }
          },
          "response": {
            "enum": [
              "json",
              "binary",
              "text",
              "stream"
            ]
          }
        }
      }
    },
    "config": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "required",
          "sensitive"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
          },
          "type": {
            "enum": [
              "string",
              "string[]",
              "integer",
              "boolean"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "sensitive": {
            "type": "boolean"
          }
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixtureDirectory"
      ],
      "properties": {
        "fixtureDirectory": {
          "type": "string",
          "pattern": "^test/[A-Za-z0-9._/-]+$"
        }
      }
    }
  }
}
